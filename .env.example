# Backend database (matches docker-compose.yml defaults)
DB_URL=jdbc:postgresql://localhost:5432/predictor
DB_USER=predictor
DB_PASSWORD=predictor

# HS256 signing key for JWTs — at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# football-data.org API key. Leave empty and keep APP_FIXTURES_PROVIDER=seed
# to run fully offline with generated demo fixtures.
FOOTBALL_DATA_API_KEY=

# seed | footballdata
APP_FIXTURES_PROVIDER=seed

# Scheduled jobs (fixture sync, result polling). Keep false in local dev;
# the admin/dev endpoints trigger the same logic manually.
APP_JOBS_ENABLED=false
